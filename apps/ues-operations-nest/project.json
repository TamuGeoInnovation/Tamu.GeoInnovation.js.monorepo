{
  "name": "ues-operations-nest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ues-operations-nest/src",
  "projectType": "application",
  "prefix": "ues-operations-nest",
  "tags": ["assets"],
  "targets": {
    "build": {
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "ues-operations-nest:build",
        "host": "0.0.0.0"
      },
      "configurations": {
        "production": {
          "buildTarget": "ues-operations-nest:build:production"
        },
        "development": {
          "buildTarget": "ues-operations-nest:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/ues-operations-nest"],
      "options": {
        "jestConfig": "apps/ues-operations-nest/jest.config.ts"
      }
    }
  }
}
