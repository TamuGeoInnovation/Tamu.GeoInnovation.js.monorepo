{
  "name": "gisday-nest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gisday-nest/src",
  "projectType": "application",
  "prefix": "gisday-nest",
  "tags": ["assets"],
  "targets": {
    "build": {
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "image-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker compose build"
          }
        ],
        "cwd": "dist/apps/gisday-nest"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "gisday-nest:build",
        "host": "0.0.0.0"
      },
      "configurations": {
        "production": {
          "buildTarget": "gisday-nest:build:production"
        },
        "development": {
          "buildTarget": "gisday-nest:build:development"
        }
      }
    },
    "migration-show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d apps/gisday-nest/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "migration-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -p -d apps/gisday-nest/src/database/data-source.ts apps/gisday-nest/src/database/migrations/{args.name}",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "migration-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d apps/gisday-nest/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "migration-revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d apps/gisday-nest/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/gisday-nest"],
      "options": {
        "jestConfig": "apps/gisday-nest/jest.config.ts"
      }
    }
  }
}
