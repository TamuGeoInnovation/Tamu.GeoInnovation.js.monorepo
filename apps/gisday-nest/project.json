{
  "name": "gisday-nest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gisday-nest/src",
  "projectType": "application",
  "prefix": "gisday-nest",
  "tags": ["assets"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/gisday-nest",
        "main": "apps/gisday-nest/src/main.ts",
        "tsConfig": "apps/gisday-nest/tsconfig.app.json",
        "assets": [
          "apps/gisday-nest/src/assets",
          "apps/gisday-nest/src/Dockerfile",
          "apps/gisday-nest/src/docker-compose.yml",
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          }
        ],
        "target": "node",
        "compiler": "tsc",
        "sourceMap": true,
        "devtool": "source-map",
        "webpackConfig": "apps/gisday-nest/webpack.config.js"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": false,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/gisday-nest/src/environments/environment.ts",
              "with": "apps/gisday-nest/src/environments/environment.prod.ts"
            }
          ],
          "generatePackageJson": true
        },
        "development": {
          "optimization": true,
          "extractLicenses": false,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/gisday-nest/src/environments/environment.ts",
              "with": "apps/gisday-nest/src/environments/environment.dev.ts"
            }
          ],
          "generatePackageJson": true
        }
      }
    },
    "image-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker compose build"
          }
        ],
        "cwd": "dist/apps/gisday-nest"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "gisday-nest:build",
        "host": "0.0.0.0"
      },
      "configurations": {
        "production": {
          "buildTarget": "gisday-nest:build:production"
        },
        "development": {
          "buildTarget": "gisday-nest:build:development"
        }
      }
    },
    "migration-show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d apps/gisday-nest/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "migration-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -p -d apps/gisday-nest/src/database/data-source.ts apps/gisday-nest/src/database/migrations/{args.name}",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "migration-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d apps/gisday-nest/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    },
    "migration-revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d apps/gisday-nest/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/gisday-nest/tsconfig.app.json",
          "TS_NODE_BASEURL": "../..",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}"
        }
      }
    }
  }
}
