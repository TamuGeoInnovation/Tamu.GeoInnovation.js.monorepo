# Settings for running gisday-nest in the local stack (docs/gisday-local.md).
#
# Copy this file OUTSIDE the repository, fill in the blanks, and pass its path to
# scripts/gisday-local.sh. Never commit the filled-in copy. Every name gisday-nest reads is listed;
# .env.sample beside this file explains each one.

PORT=3333
GLOBAL_PREFIX=api
ORIGINS=http://localhost:4201
LOGGING=false

# The one GIS Day Auth0 tenant. Sign-in does not work locally yet (#1522), but the API reads these
# at startup.
AUTH0_AUDIENCE=
AUTH0_ISSUER_URL=
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_MANAGEMENT_CLIENT=
AUTH0_MANAGEMENT_SECRET=

# Where uploads are written inside the container.
APP_DATA=

# The local SQL Server container on the gisday-local Docker network. Never production or the shared
# dev server. gisday_app can read and write data but not change tables.
TYPEORM_CONNECTION=mssql
TYPEORM_HOST=gisday-db
TYPEORM_DATABASE=gisday-nest-eh
TYPEORM_USERNAME=gisday_app
TYPEORM_PASSWORD=
TYPEORM_SYNCHRONIZE=false
TYPEORM_DROP_SCHEMA=false
TYPEORM_LOGGING=false
# The container's certificate is self-signed, so the driver has to be told to trust it, for example
# {"options":{"trustServerCertificate":true}}.
TYPEORM_EXTRA=

# Email stays off locally: leave every MAILROOM_ value blank.
MAILROOM_URL=
MAILROOM_FROM=
MAILROOM_TO=
MAILROOM_BCC=

REDIS_HOST=gisday-redis
REDIS_PORT=6379
NX_DAEMON=false
