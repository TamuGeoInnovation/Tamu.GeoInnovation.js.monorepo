# Settings for running gisday-nest in the local stack (docs/gisday-local.md).
#
# Copy this file OUTSIDE the repository, to gisday-api.local.env in GISDAY_LOCAL_DIR (default
# C:/TAMU/gisday-local). As it stands it holds no secrets and runs the local stack; never commit a copy
# with anything added. Every name gisday-nest reads is listed; .env.sample beside this file explains
# each one.

PORT=3333
GLOBAL_PREFIX=api
ORIGINS=http://localhost:4201
LOGGING=false

# The development Auth0 tenant, txgisday-dev, which checks sign-ins (#1623). Neither is a secret: the
# front end's environment.local.ts holds the same two.
AUTH0_AUDIENCE=gisday.dev.api
AUTH0_ISSUER_URL=https://txgisday-dev.us.auth0.com/

# Without management credentials the API runs without them (#1759): the admin Users page and a user's
# own profile answer 503, and rosters and competition results show placeholders for names and emails.
# The development tenant's credentials are in auth0-dev.local.env, which scripts/gisday-auth0-dev.ps1
# writes and scripts/gisday-local.sh passes after this file, turning this off. Leave these blank here.
# Only the local build reads AUTH0_MANAGEMENT_DISABLED.
AUTH0_MANAGEMENT_DISABLED=true
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_MANAGEMENT_CLIENT=
AUTH0_MANAGEMENT_SECRET=

# Where uploads are written inside the container. They are lost when the container is removed.
APP_DATA=/tmp/gisday-app-data

# The local SQL Server container on the gisday-local Docker network. Never production or the shared
# dev server. gisday_app can read and write data but not change tables.
TYPEORM_CONNECTION=mssql
TYPEORM_HOST=gisday-db
TYPEORM_DATABASE=gisday-nest-eh
TYPEORM_USERNAME=gisday_app
# Leave blank: scripts/gisday-local.sh passes the password it wrote to local-db.env.
TYPEORM_PASSWORD=
TYPEORM_SYNCHRONIZE=false
TYPEORM_DROP_SCHEMA=false
TYPEORM_LOGGING=false
# The container's certificate is self-signed, so the driver has to be told to trust it.
TYPEORM_EXTRA={"options":{"trustServerCertificate":true}}

# Email stays off locally: leave every MAILROOM_ value blank.
MAILROOM_URL=
MAILROOM_FROM=
MAILROOM_TO=
MAILROOM_BCC=

REDIS_HOST=gisday-redis
REDIS_PORT=6379
NX_DAEMON=false
