{
  "name": "oidc-admin-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/oidc-admin-angular/src",
  "prefix": "tamu-gisc",
  "tags": [],
  "implicitDependencies": ["assets", "sass"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "outputPath": {
          "base": "dist/apps/oidc-admin-angular"
        },
        "index": "apps/oidc-admin-angular/src/index.html",
        "polyfills": ["apps/oidc-admin-angular/src/polyfills.ts"],
        "tsConfig": "apps/oidc-admin-angular/tsconfig.app.json",
        "aot": false,
        "assets": [
          "apps/oidc-admin-angular/src/favicon.ico",
          "apps/oidc-admin-angular/src/assets",
          {
            "glob": "**/*",
            "input": "./libs/assets/powershell",
            "output": "./assets/powershell"
          }
        ],
        "styles": ["apps/oidc-admin-angular/src/styles.scss"],
        "scripts": [],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "browser": "apps/oidc-admin-angular/src/main.ts"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/oidc-admin-angular/src/environments/environment.ts",
              "with": "apps/oidc-admin-angular/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "baseHref": "/admin/",
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/oidc-admin-angular/src/environments/environment.ts",
              "with": "apps/oidc-admin-angular/src/environments/environment.dev.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "baseHref": "/admin/",
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      },
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": ""
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "host": "0.0.0.0",
        "buildTarget": "oidc-admin-angular:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "oidc-admin-angular:build:production"
        },
        "development": {
          "buildTarget": "oidc-admin-angular:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "oidc-admin-angular:build"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/oidc-admin-angular/jest.config.ts"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/oidc-admin-angular"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
