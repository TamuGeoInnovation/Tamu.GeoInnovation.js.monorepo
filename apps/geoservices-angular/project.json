{
  "name": "geoservices-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/geoservices-angular/src",
  "prefix": "tamu-gisc",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "outputPath": "dist/apps/geoservices-angular",
        "index": "apps/geoservices-angular/src/index.html",
        "main": "apps/geoservices-angular/src/main.ts",
        "polyfills": "apps/geoservices-angular/src/polyfills.ts",
        "tsConfig": "apps/geoservices-angular/tsconfig.app.json",
        "aot": false,
        "assets": [
          "apps/geoservices-angular/src/favicon.ico",
          "apps/geoservices-angular/src/assets",
          "apps/geoservices-angular/src/Dockerfile",
          "apps/geoservices-angular/src/.dockerignore",
          "apps/geoservices-angular/src/docker-compose.yml",
          "apps/geoservices-angular/src/.nginx",
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          },
          {
            "glob": "**/*",
            "input": "node_modules/@arcgis/core/assets",
            "output": "/assets/arcgis"
          }
        ],
        "styles": [
          "apps/geoservices-angular/src/styles.scss"
        ],
        "scripts": [],
        "vendorChunk": true,
        "extractLicenses": false,
        "buildOptimizer": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/geoservices-angular/src/environments/environment.ts",
              "with": "apps/geoservices-angular/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "vendorChunk": false,
          "buildOptimizer": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/geoservices-angular/src/environments/environment.ts",
              "with": "apps/geoservices-angular/src/environments/environment.dev.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "vendorChunk": false,
          "buildOptimizer": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      },
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": ""
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "browserTarget": "geoservices-angular:build",
        "proxyConfig": "apps/geoservices-angular/proxy.conf.json",
        "host": "0.0.0.0"
      },
      "configurations": {
        "production": {
          "browserTarget": "geoservices-angular:build:production"
        },
        "development": {
          "browserTarget": "geoservices-angular:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "geoservices-angular:build"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/geoservices-angular/jest.config.ts",
        "passWithNoTests": true
      },
      "outputs": [
        "{workspaceRoot}/coverage/apps/geoservices-angular"
      ]
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/geoservices-angular/src/**/*.ts",
          "apps/geoservices-angular/src/**/*.html"
        ]
      }
    }
  },
  "tags": [],
  "implicitDependencies": [
    "assets",
    "sass"
  ]
}
