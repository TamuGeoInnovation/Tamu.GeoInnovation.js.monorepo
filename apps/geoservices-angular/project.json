{
  "name": "geoservices-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/geoservices-angular/src",
  "prefix": "tamu-gisc",
  "tags": [],
  "implicitDependencies": ["assets", "sass"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "",
      "options": {
        "outputPath": {
          "base": "dist/apps/geoservices-angular",
          "browser": ""
        },
        "index": "apps/geoservices-angular/src/index.html",
        "polyfills": ["apps/geoservices-angular/src/polyfills.ts"],
        "tsConfig": "apps/geoservices-angular/tsconfig.app.json",
        "aot": false,
        "assets": [
          "apps/geoservices-angular/src/favicon.ico",
          "apps/geoservices-angular/src/assets",
          "apps/geoservices-angular/src/Dockerfile",
          "apps/geoservices-angular/src/.dockerignore",
          "apps/geoservices-angular/src/docker-compose.yml",
          "apps/geoservices-angular/src/.nginx",
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          }
        ],
        "styles": ["apps/geoservices-angular/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "scripts": [],
        "loader": {
          ".woff2": "file",
          ".woff": "file",
          ".ttf": "file"
        },
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "browser": "apps/geoservices-angular/src/main.ts"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/geoservices-angular/src/environments/environment.ts",
              "with": "apps/geoservices-angular/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/geoservices-angular/src/environments/environment.ts",
              "with": "apps/geoservices-angular/src/environments/environment.dev.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": {
        "proxyConfig": "apps/geoservices-angular/proxy.conf.json",
        "host": "0.0.0.0",
        "buildTarget": "geoservices-angular:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "geoservices-angular:build:production"
        },
        "development": {
          "buildTarget": "geoservices-angular:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "geoservices-angular:build"
      }
    }
  }
}
