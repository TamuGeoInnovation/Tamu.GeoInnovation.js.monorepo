{
  "name": "mailroom-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mailroom-angular/src",
  "prefix": "tamu-gisc",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/mailroom-angular",
          "browser": ""
        },
        "index": "apps/mailroom-angular/src/index.html",
        "polyfills": ["apps/mailroom-angular/src/polyfills.ts"],
        "tsConfig": "apps/mailroom-angular/tsconfig.app.json",
        "aot": false,
        "assets": [
          "apps/mailroom-angular/src/favicon.ico",
          "apps/mailroom-angular/src/assets",
          "apps/mailroom-angular/src/Dockerfile",
          "apps/mailroom-angular/src/.dockerignore",
          "apps/mailroom-angular/src/docker-compose.yml",
          "apps/mailroom-angular/src/.nginx"
        ],
        "styles": ["apps/mailroom-angular/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "scripts": [],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "browser": "apps/mailroom-angular/src/main.ts"
      },
      "configurations": {
        "production": {
          "aot": true,
          "optimization": true,
          "sourceMap": false,
          "extractLicenses": true,
          "namedChunks": false,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/mailroom-angular/src/environments/environment.ts",
              "with": "apps/mailroom-angular/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "mailroom-angular:build:production"
        },
        "development": {
          "buildTarget": "mailroom-angular:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "host": "0.0.0.0"
      },
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "mailroom-angular:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/mailroom-angular"],
      "options": {
        "jestConfig": "apps/mailroom-angular/jest.config.ts",
        "tsConfig": "apps/mailroom-angular/tsconfig.spec.json"
      }
    }
  }
}
