{
  "name": "gisday-competitions-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "prefix": "tamu-gisc",
  "projectType": "application",
  "sourceRoot": "apps/gisday-competitions-angular/src",
  "tags": [],
  "implicitDependencies": ["assets", "sass"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "",
      "options": {
        "index": "apps/gisday-competitions-angular/src/index.html",
        "outputPath": {
          "base": "dist/apps/gisday-competitions-angular",
          "browser": ""
        },
        "polyfills": ["apps/gisday-competitions-angular/src/polyfills.ts"],
        "tsConfig": "apps/gisday-competitions-angular/tsconfig.app.json",
        "assets": [
          "apps/gisday-competitions-angular/src/favicon.ico",
          "apps/gisday-competitions-angular/src/assets",
          "apps/gisday-competitions-angular/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          }
        ],
        "scripts": [],
        "styles": ["apps/gisday-competitions-angular/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "aot": false,
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "browser": "apps/gisday-competitions-angular/src/main.ts"
      },
      "configurations": {
        "production": {
          "outputHashing": "all",
          "budgets": [
            {
              "maximumError": "5mb",
              "maximumWarning": "2mb",
              "type": "initial"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/gisday-competitions-angular/src/environments/environment.ts",
              "with": "apps/gisday-competitions-angular/src/environments/environment.prod.ts"
            }
          ],
          "baseHref": "/competitions/app/",
          "aot": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "serviceWorker": "apps/gisday-competitions-angular/ngsw-config.json",
          "sourceMap": false
        },
        "development": {
          "outputHashing": "all",
          "budgets": [
            {
              "maximumError": "5mb",
              "maximumWarning": "2mb",
              "type": "initial"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/gisday-competitions-angular/src/environments/environment.ts",
              "with": "apps/gisday-competitions-angular/src/environments/environment.dev.ts"
            }
          ],
          "baseHref": "/competitions/app/",
          "aot": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "serviceWorker": "apps/gisday-competitions-angular/ngsw-config.json",
          "sourceMap": false
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "gisday-competitions-angular:build"
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "continuous": true,
      "options": {
        "host": "0.0.0.0",
        "buildTarget": "gisday-competitions-angular:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "gisday-competitions-angular:build:production"
        },
        "development": {
          "buildTarget": "gisday-competitions-angular:build:development"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/gisday-competitions-angular"],
      "options": {
        "jestConfig": "apps/gisday-competitions-angular/jest.config.ts",
        "tsConfig": "apps/gisday-competitions-angular/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
