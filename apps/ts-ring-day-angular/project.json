{
  "name": "ts-ring-day-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ts-ring-day-angular/src",
  "prefix": "tamu-gisc",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/ts-ring-day-angular"
        },
        "index": "apps/ts-ring-day-angular/src/index.html",
        "polyfills": ["apps/ts-ring-day-angular/src/polyfills.ts"],
        "tsConfig": "apps/ts-ring-day-angular/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/ts-ring-day-angular/src/favicon.ico",
          "apps/ts-ring-day-angular/src/assets",
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          }
        ],
        "styles": ["apps/ts-ring-day-angular/src/styles.scss"],
        "scripts": [],
        "browser": "apps/ts-ring-day-angular/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "20kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/ts-ring-day-angular/src/environments/environment.ts",
              "with": "apps/ts-ring-day-angular/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "ts-ring-day-angular:build:production"
        },
        "development": {
          "buildTarget": "ts-ring-day-angular:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "host": "0.0.0.0"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ts-ring-day-angular:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/ts-ring-day-angular"],
      "options": {
        "jestConfig": "apps/ts-ring-day-angular/jest.config.ts"
      }
    }
  }
}
