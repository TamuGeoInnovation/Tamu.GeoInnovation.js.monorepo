{
  "name": "gisday-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gisday-angular/src",
  "prefix": "tamu-gisc",
  "tags": [],
  "implicitDependencies": ["assets", "sass", "gisday-sass"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-app"],
      "outputs": ["{workspaceRoot}/dist/apps/gisday-angular"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "node -r ts-node/register apps/gisday-angular/scripts/site-pages.ts dist/apps/gisday-angular",
        "env": {
          "TS_NODE_TRANSPILE_ONLY": "true",
          "TS_NODE_SKIP_PROJECT": "true",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"node16\",\"moduleResolution\":\"node16\",\"target\":\"es2022\"}"
        }
      },
      "configurations": {
        "local": {},
        "production": {},
        "development": {}
      }
    },
    "build-app": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "",
      "options": {
        "crossOrigin": "anonymous",
        "outputPath": {
          "base": "dist/apps/gisday-angular",
          "browser": ""
        },
        "index": "apps/gisday-angular/src/index.html",
        "polyfills": ["apps/gisday-angular/src/polyfills.ts"],
        "tsConfig": "apps/gisday-angular/tsconfig.app.json",
        "assets": [
          "apps/gisday-angular/src/favicon.ico",
          "apps/gisday-angular/src/assets",
          "apps/gisday-angular/src/Dockerfile",
          "apps/gisday-angular/src/.dockerignore",
          "apps/gisday-angular/src/docker-compose.yml",
          "apps/gisday-angular/src/.nginx",
          "apps/gisday-angular/src/manifest.webmanifest",
          {
            "glob": "maplibre-gl-worker.mjs",
            "input": "node_modules/maplibre-gl/dist",
            "output": "maplibre"
          },
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          }
        ],
        "styles": ["apps/gisday-angular/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "scripts": [],
        "loader": {
          ".woff2": "file",
          ".woff": "file",
          ".ttf": "file"
        },
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "browser": "apps/gisday-angular/src/main.ts"
      },
      "configurations": {
        "local": {
          "fileReplacements": [
            {
              "replace": "apps/gisday-angular/src/environments/environment.ts",
              "with": "apps/gisday-angular/src/environments/environment.local.ts"
            }
          ]
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/gisday-angular/src/environments/environment.ts",
              "with": "apps/gisday-angular/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": false,
          "serviceWorker": "apps/gisday-angular/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/gisday-angular/src/environments/environment.ts",
              "with": "apps/gisday-angular/src/environments/environment.dev.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": false,
          "serviceWorker": "apps/gisday-angular/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      },
      "cache": true,
      "inputs": ["production", "^production"],
      "dependsOn": ["^build"]
    },
    "image-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker compose build"
          }
        ],
        "cwd": "dist/apps/gisday-angular"
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": {
        "host": "0.0.0.0",
        "buildTarget": "gisday-angular:build-app"
      },
      "configurations": {
        "production": {
          "buildTarget": "gisday-angular:build-app:production"
        },
        "development": {
          "buildTarget": "gisday-angular:build-app:development"
        },
        "local": {
          "buildTarget": "gisday-angular:build-app:local",
          "proxyConfig": "apps/gisday-angular/proxy.local.json"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "gisday-angular:build-app"
      }
    }
  }
}
