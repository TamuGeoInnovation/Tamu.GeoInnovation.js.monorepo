{
  "name": "gisday-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gisday-angular/src",
  "prefix": "tamu-gisc",
  "tags": [],
  "implicitDependencies": ["assets", "sass", "gisday-sass"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "crossOrigin": "anonymous",
        "outputPath": {
          "base": "dist/apps/gisday-angular",
          "browser": ""
        },
        "index": "apps/gisday-angular/src/index.html",
        "polyfills": ["apps/gisday-angular/src/polyfills.ts"],
        "tsConfig": "apps/gisday-angular/tsconfig.app.json",
        "assets": [
          "apps/gisday-angular/src/favicon.ico",
          "apps/gisday-angular/src/assets",
          "apps/gisday-angular/src/Dockerfile",
          "apps/gisday-angular/src/.dockerignore",
          "apps/gisday-angular/src/docker-compose.yml",
          "apps/gisday-angular/src/.nginx",
          "apps/gisday-angular/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "./libs/assets/",
            "output": "./assets"
          }
        ],
        "styles": ["apps/gisday-angular/src/styles.scss"],
        "scripts": [],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "browser": "apps/gisday-angular/src/main.ts"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/gisday-angular/src/environments/environment.ts",
              "with": "apps/gisday-angular/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": false,
          "serviceWorker": "apps/gisday-angular/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/gisday-angular/src/environments/environment.ts",
              "with": "apps/gisday-angular/src/environments/environment.dev.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": false,
          "serviceWorker": "apps/gisday-angular/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      },
      "defaultConfiguration": ""
    },
    "image-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker compose build"
          }
        ],
        "cwd": "dist/apps/gisday-angular"
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "host": "0.0.0.0",
        "buildTarget": "gisday-angular:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "gisday-angular:build:production"
        },
        "development": {
          "buildTarget": "gisday-angular:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "gisday-angular:build"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/gisday-angular/jest.config.ts"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/gisday-angular"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
