{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [],
  "dataGroups": [
    {
      "name": "api",
      "urls": ["https://txgisday.org/api/**"],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "5m",
        "strategy": "freshness",
        "timeout": "250u"
      }
    },
    {
      "name": "tiles",
      "urls": ["https://basemaps.arcgis.com/arcgis/rest/services/**"],
      "cacheConfig": {
        "maxSize": 3000,
        "maxAge": "30d",
        "strategy": "performance",
        "timeout": "10u"
      }
    },
    {
      "name": "arcgis-js",
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "5d",
        "maxSize": 100,
        "timeout": "100u"
      },
      "urls": ["https://js.arcgis.com/**", "https://www.arcgis.com/sharing/**", "https://cdn.arcgis.com/sharing/**"]
    }
  ]
}
