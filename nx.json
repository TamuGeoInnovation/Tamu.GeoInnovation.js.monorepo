{
  "cli": {
    "analytics": "b3417ad8-d366-42d6-9c0a-ffba263c7ff4"
  },
  "defaultProject": "aggiemap-angular",
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "scss",
      "skipTests": true,
      "type": "component"
    },
    "@nx/angular:guard": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@nx/angular:service": {
      "skipTests": true,
      "type": "service"
    },
    "@nx/angular:pipe": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@nx/angular:directive": {
      "skipTests": true,
      "type": "directive"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "nxCloudId": "68bf66e05ea3cd1b684d15cb",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": [
      {
        "dependsOn": ["^build"],
        "inputs": ["production", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/webpack/plugin"
        },
        "outputs": ["{projectRoot}/{options.outputPath}"]
      }
    ],
    "test": [
      {
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          "{workspaceRoot}/vitest.preset.mts",
          "{workspaceRoot}/test/polyfills.ts",
          "{workspaceRoot}/test/vitest-setup-angular.ts",
          {
            "externalDependencies": ["vitest"]
          },
          {
            "env": "CI"
          }
        ],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js",
          "{workspaceRoot}/test/polyfills.ts",
          {
            "externalDependencies": ["jest", "ts-jest", "jest-preset-angular", "jest-junit"]
          }
        ],
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/vitest.config.mts",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "parallel": 1,
  "useInferencePlugins": false,
  "defaultBase": "development",
  "plugins": [
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
