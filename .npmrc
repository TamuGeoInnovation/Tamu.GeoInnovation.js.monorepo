# Install scripts (#2293). A dependency's preinstall, install or postinstall script runs only if allowScripts in
# package.json names it, and with this an unreviewed one fails the install (ESTRICTALLOWSCRIPTS) rather than running
# with a warning. Review it, then: npm install-scripts approve --no-allow-scripts-pin <name>, or deny <name>.
# tools/security-findings/install-scripts.mjs checks the same from the lock in CI. Needs npm 11.19 or later.
strict-allow-scripts=true
