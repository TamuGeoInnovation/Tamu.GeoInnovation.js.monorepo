{
  // Typechecks the AggieMap smoke suite (#1470). Playwright strips types when it loads a spec, so
  // without this a type error here fails nothing. CI runs `tsc -p test/smoke/aggiemap` in lint.yml.
  //
  // Standalone rather than extending tsconfig.base.json: the suite runs under Playwright's own loader,
  // not an Nx build, and is checked strictly, which the workspace is not.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "../../../playwright.aggiemap-smoke.config.ts"]
}
