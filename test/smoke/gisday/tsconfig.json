{
  // Typechecks the GIS Day smoke suite (#3646), as test/smoke/aggiemap/tsconfig.json does AggieMap's. Playwright strips
  // types when it loads a spec, so without this a type error here fails nothing. CI runs `tsc -p test/smoke/gisday` in
  // lint.yml.
  //
  // The same settings as AggieMap's: standalone rather than extending tsconfig.base.json, because the suite runs under
  // Playwright's own loader, not an Nx build, and is checked strictly, which the workspace is not.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "../../../playwright.smoke.config.ts"]
}
