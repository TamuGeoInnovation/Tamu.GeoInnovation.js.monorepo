{
  "name": "geoprocessing-v4",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/geoprocessing/v4/src",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/geoprocessing/v4/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/geoprocessing/v4"],
      "options": {
        "jestConfig": "libs/geoprocessing/v4/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/geoprocessing/v4",
        "tsConfig": "libs/geoprocessing/v4/tsconfig.lib.json",
        "packageJson": "libs/geoprocessing/v4/package.json",
        "main": "libs/geoprocessing/v4/src/index.ts",
        "assets": ["libs/geoprocessing/v4/*.md"],
        "updateBuildableProjectDepsInPackageJson": true
      }
    }
  },
  "tags": []
}
