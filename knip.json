{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/*/src/main.ts",
    "apps/*/src/polyfills.ts",
    "apps/*/webpack.config.js",
    "apps/*/src/**/*.spec.ts",
    "apps/*/src/environments/*.ts",
    "apps/*/src/database/migrations/*.ts",
    "apps/*/src/database/data-source.ts",
    "libs/**/*.spec.ts",
    "{apps,libs}/**/{vitest.config.mts,eslint.config.mjs}",
    "{vitest.preset.mts,eslint.config.mjs,serve-dist.js,decorate-angular-cli.js,playwright*.config.ts}",
    "tools/**/*.{js,mjs,ts}",
    "scripts/**/*.{js,mjs,ts}",
    "test/**/*.ts"
  ],
  "project": [
    "apps/**/*.{ts,js,mjs,mts}",
    "libs/**/*.{ts,js,mjs,mts}",
    "tools/**/*.{js,mjs,ts}",
    "scripts/**/*.{js,mjs,ts}",
    "test/**/*.ts",
    "*.{js,mjs,mts,ts}"
  ],
  // Used, but not by anything knip follows (#3720, #3725). Each was checked by hand on 26 November 2026.
  "ignoreDependencies": [
    // require()d by @nx/eslint-plugin's flat/javascript and flat/typescript configs, which eslint.config.mjs uses.
    "@eslint/js",
    // require()d by @nx/eslint-plugin's flat/angular and flat/angular-template configs, used by every Angular project.
    "angular-eslint",
    // require()d by @nx/eslint-plugin's flat/javascript, flat/typescript and flat/angular configs.
    "typescript-eslint",
    // Run by scripts/check-format.mjs (a lint.yml step) through npx, and checked for by @nx/eslint-plugin.
    "prettier"
  ]
}
